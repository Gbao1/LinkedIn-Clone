@model Web.Models.Profile
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

@{
    ViewData["Title"] = "Profile";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    <div class="profile-header d-flex align-items-center" style="gap:12px;">
        <a asp-controller="Profiles" asp-action="Details" asp-route-userId="@Model.UserId" style="display:inline-flex;align-items:center;text-decoration:none;color:inherit;">
            <img src="@(String.IsNullOrEmpty(Model.AvatarUrl) ? Url.Content("~/images/default-avatar.png") : Model.AvatarUrl)" alt="Avatar" style="width:100px;height:100px;border-radius:12px;object-fit:cover" />
            <div style="margin-left:12px;">
                <h2 style="margin:0">@Model.FullName</h2>
                <p class="text-muted" style="margin:0">@Model.Headline</p>
            </div>
        </a>
    </div>

    <div class="mt-3">
        <h4>Summary</h4>
        <p>@Model.Summary</p>
    </div>

    <div class="profile-sections">
        @{
            if (!string.IsNullOrEmpty(Model.SectionsJson))
            {
                try {
                    var sections = System.Text.Json.JsonSerializer.Deserialize<List<Dictionary<string,string>>>(Model.SectionsJson);
                    foreach (var s in sections)
                    {
                        <div class="profile-section">
                            <h5>@s.GetValueOrDefault("title")</h5>
                            <p>@s.GetValueOrDefault("content")</p>
                        </div>
                    }
                } catch {
                    <p class="text-muted">No sections</p>;
                }
            }
        }
    </div>

    @* show Edit only when current user owns the profile *@
    @{
        var currentUser = await UserManager.GetUserAsync(User);
        if (currentUser != null && currentUser.Id == Model.UserId)
        {
            <a asp-action="Edit" class="btn btn-primary">Edit profile</a>
        }
    }
</div>