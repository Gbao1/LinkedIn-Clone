@model Web.Models.Profile
@{
    ViewData["Title"] = "Edit Profile";
}
<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    <h2>Edit Profile</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="UserId" value="@Model.UserId" />

        <div class="form-group">
            <label>Full Name</label>
            <input name="FullName" class="form-control" value="@(Model.FullName ?? "")" />
        </div>

        <div class="form-group">
            <label>Headline</label>
            <input name="Headline" class="form-control" value="@(Model.Headline ?? "")" />
        </div>

        <div class="form-group">
            <label>Location</label>
            <input name="Location" class="form-control" value="@(Model.Location ?? "")" />
        </div>

        <div class="form-group">
            <label>Summary</label>
            <textarea name="Summary" class="form-control" rows="4">@Model.Summary</textarea>
        </div>

        <div class="form-group">
            <label>Avatar URL (optional)</label>
            <input name="AvatarUrl" class="form-control" value="@(Model.AvatarUrl ?? "")" />
        </div>

        <h4>Sections (Experience, Education, Projects)</h4>

        <div id="sections">
            @{
                // Deserialize into a predictable structure (list of dictionaries)
                var sections = new List<Dictionary<string, string>>();

                if (!string.IsNullOrEmpty(Model.SectionsJson))
                {
                    try
                    {
                        sections = System.Text.Json.JsonSerializer
                            .Deserialize<List<Dictionary<string, string>>>(Model.SectionsJson)
                            ?? new List<Dictionary<string, string>>();
                    }
                    catch
                    {
                        sections = new List<Dictionary<string, string>>();
                    }
                }

                if (sections.Count == 0)
                {
                    sections.Add(new Dictionary<string, string>
                    {
                        { "title", "" },
                        { "content", "" }
                    });
                }

                for (int i = 0; i < sections.Count; i++)
                {
                    var s = sections[i];
                    var title = s.ContainsKey("title") ? s["title"] : "";
                    var content = s.ContainsKey("content") ? s["content"] : "";
            }

                for (int i = 0; i < sections.Count; i++)
            {
                var s = sections[i];
                var title = s.ContainsKey("title") ? s["title"] : "";
                var content = s.ContainsKey("content") ? s["content"] : "";
                <div class="section-block" data-index="@i">
                    <div class="form-group">
                        <label>Section title</label>
                        <input name="sectionsTitle" class="form-control" value="@(title ?? "")" />
                    </div>
                    <div class="form-group">
                        <label>Content</label>
                        <textarea name="sectionsContent" class="form-control" rows="3">@(content ?? "")</textarea>
                    </div>
                    <button type="button" class="btn btn-danger remove-section">Remove</button>
                    <hr />
                </div>
            }
            }
        </div>

        <p>
            <button type="button" id="addSection" class="btn btn-secondary">Add section</button>
        </p>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save profile</button>
            <a asp-action="Details" class="btn btn-light">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const sectionsRoot = document.getElementById('sections');

            function addSection(title = '', content = '') {
                const block = document.createElement('div');
                block.className = 'section-block';
                block.innerHTML = `
                        <div class="form-group">
                            <label>Section title</label>
                            <input name="sectionsTitle" class="form-control" value="${escapeHtml(title)}">
                        </div>
                        <div class="form-group">
                            <label>Content</label>
                            <textarea name="sectionsContent" class="form-control" rows="3">${escapeHtml(content)}</textarea>
                        </div>
                        <button type="button" class="btn btn-danger remove-section">Remove</button>
                        <hr />
                    `;
                sectionsRoot.appendChild(block);
                block.querySelector('.remove-section').addEventListener('click', function () {
                    block.remove();
                });
            }

            document.getElementById('addSection').addEventListener('click', function () {
                addSection('', '');
            });

            // Wire up existing remove buttons
            document.querySelectorAll('.remove-section').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    btn.closest('.section-block').remove();
                });
            });

            // Simple HTML escape function
            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }
        })();
    </script>
}
