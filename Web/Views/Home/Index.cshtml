@model Link.HomeIndexViewModel
@{
	ViewData["Title"] = "Home";
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>Link — Home</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
	<style>
		body { background: #f3f6fb; }
		.hero { background: linear-gradient(90deg,#0d6efd33,#6f42c133); padding: 2rem; border-radius: .75rem; }
		.profile-avatar { width:72px; height:72px; border-radius: .5rem; object-fit:cover; }
		.card-modern { border-radius: .75rem; box-shadow: 0 6px 18px rgba(20,30,60,0.06); }
		.muted { color: #6c757d; }
		.connect-btn { border-radius: 999px; }
	</style>
</head>
<body>

    <div class="container py-4">
        <div class="row g-3">
            <!-- main content -->
            <div class="col-lg-8">
                <div class="hero card-modern p-4 mb-3">
                    <div class="d-flex align-items-center">
                        <img src="@Model.CurrentUser.AvatarUrl" alt="avatar" class="profile-avatar me-3" />
                        <div>
                            <h4 class="mb-0">@Model.CurrentUser.FullName</h4>
                            <div class="muted">@Model.CurrentUser.Headline</div>
                        </div>
                        <div class="ms-auto">
                            <button class="btn btn-outline-primary connect-btn">Share an update</button>
                        </div>
                    </div>
                </div>
                <!-- Feed -->
                <div>
                    @foreach (var item in Model.FeedItems)
					{
                    <div class="card-modern bg-white p-3 mb-3">
                        <div class="d-flex">
                            <img src="https://via.placeholder.com/56" class="rounded me-3" />
                            <div class="flex-grow-1">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <strong>@item.Author</strong>
                                        <div class="muted small">@item.AuthorTitle • @item.TimeAgo</div>
                                    </div>
                                    <div class="ms-auto muted">•••</div>
                                </div>
                                <p class="mt-2 mb-1">@item.Text</p>
                                <div class="d-flex align-items-center mt-2 small muted">
                                    @if (User.Identity.IsAuthenticated)
										{
                                    <button type="button" onclick="likePost(@item.Id)" class="btn btn-sm btn-light me-2">Like</button>
                                    <button type="button" class="btn btn-sm btn-light me-2">Comment</button>
                                    <button type="button" class="btn btn-sm btn-light">Share</button>
										}
										else
										{
                                    <button type="button" onclick="showSignInPopup()" class="btn btn-sm btn-light me-2">Like</button>
                                    <button type="button" onclick="showSignInPopup()" class="btn btn-sm btn-light me-2">Comment</button>
                                    <button type="button" onclick="showSignInPopup()" class="btn btn-sm btn-light">Share</button>
										}
                                </div>

                            </div>
                        </div>
                    </div>
					}
                </div>
            </div>

            <!-- sidebar -->
            <div class="col-lg-4">
                <div class="card-modern bg-white p-3 mb-3">
                    <h6 class="mb-3">People You May Know</h6>
                    @foreach (var s in Model.Suggestions)
			{
                    <div class="d-flex align-items-center mb-3">
                        <img src="https://via.placeholder.com/48" class="rounded-circle me-3" />
                        <div>
                            <div><strong>@s.FullName</strong></div>
                            <div class="small muted">@s.Headline</div>
                        </div>
                        <div class="ms-auto">
                            <button class="btn btn-sm btn-outline-primary">Connect</button>
                        </div>
                    </div>
			}
                </div>


                <div class="card-modern bg-white p-3 mb-3">
                    <h6 class="mb-3">Trending Topics</h6>
                    <ul class="list-unstyled small muted mb-0">
                        <li>#cloud • 9,321 followers</li>
                        <li>#dotnet • 6,214 followers</li>
                        <li>#ai • 18,041 followers</li>
                    </ul>
                </div>
            </div>
        </div>
        <footer class="mt-4 muted small">© Link — Keeping Professionals Active.</footer>
    </div>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="ModalSignLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="ModalSignLabel">Sign In</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form method="post" action="/Identity/Account/Login">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email</label>
                            <input type="email" class="form-control" id="loginEmail" name="Input.Email" required />
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" name="Input.Password" required />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Sign In</button>
                    </form>
                    <p class="mt-2 small text-center">
                        <a href="/Identity/Account/Register">Register</a> |
                        <a href="/Identity/Account/ForgotPassword">Forgot password?</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function likePost(id) {
            // Example action for authenticated users
            alert('Liked post #' + id);
        }

        function showSignInPopup() {
            var loginModal = new bootstrap.Modal(document.getElementById('loginModal'));
            loginModal.show();
        }

    </script>
</body>
</html>